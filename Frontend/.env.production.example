# ===========================================
# SCHOOL IERP FRONTEND - PRODUCTION ENVIRONMENT
# ===========================================
# Copy this file to .env.production and fill in your values
# These values are embedded at build time!

# ===========================================
# API CONFIGURATION (REQUIRED)
# ===========================================
# Your production API URL (must include /api/v1 path)
VITE_API_BASE_URL=https://api.yourschool.com/api/v1

# ===========================================
# BUILD NOTES
# ===========================================
# - Run `npm run build` to create production build
# - The VITE_API_BASE_URL will be embedded in the bundle
# - If not set, the app will use relative URLs (/api/v1)
# - For same-origin deployment, you can leave this blank
