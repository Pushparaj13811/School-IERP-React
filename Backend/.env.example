# ===========================================
# SCHOOL IERP BACKEND - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3000

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://username:password@localhost:5432/school_erp_db"
# Direct URL for Prisma migrations (usually same as DATABASE_URL)
DIRECT_URL="postgresql://username:password@localhost:5432/school_erp_db"

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ===========================================
# CORS & CLIENT
# ===========================================
# Your frontend URL
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# RATE LIMITING
# ===========================================
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window for general API
RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window for authentication endpoints
RATE_LIMIT_AUTH_MAX=5
# Comma-separated IPs to whitelist (skip rate limiting)
RATE_LIMIT_WHITELIST=
# Comma-separated IPs to blacklist (always block)
RATE_LIMIT_BLACKLIST=

# ===========================================
# REQUEST LIMITS
# ===========================================
BODY_LIMIT=10kb
UPLOAD_LIMIT=5mb

# ===========================================
# EMAIL (SMTP)
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourschool.com

# ===========================================
# ADMIN SEEDER (for npm run seed:admin)
# ===========================================
ADMIN_EMAIL=admin@yourschool.com
ADMIN_FULL_NAME=System Admin
ADMIN_PHONE=0000000000
ADMIN_DOB=1990-01-01
ADMIN_EMERGENCY_CONTACT=0000000000

# ===========================================
# SCHOOL INFORMATION (for seeder)
# ===========================================
SCHOOL_ADDRESS=School Address
SCHOOL_STREET=Main Street
SCHOOL_CITY=City
SCHOOL_WARD=1
SCHOOL_MUNICIPALITY=Municipality
SCHOOL_DISTRICT=District
SCHOOL_PROVINCE=Province
SCHOOL_COUNTRY=Nepal

# ===========================================
# REDIS (Optional - for distributed rate limiting)
# ===========================================
# Enable Redis for distributed rate limiting across multiple instances
REDIS_ENABLED=false
# Redis connection URL (alternative to individual settings below)
REDIS_URL=redis://localhost:6379
# Individual Redis settings (used if REDIS_URL is not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Connection retry settings
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# ===========================================
# CONNECTION POOL (Optional - for production)
# ===========================================
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_TIMEOUT=30000
